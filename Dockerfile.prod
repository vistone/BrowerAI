# 多阶段生产优化 Dockerfile

# ==================== Builder Stage ====================
FROM rust:1.75-slim as builder

WORKDIR /app

# 安装构建依赖
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# 复制源代码
COPY . .

# 构建优化的二进制（release 模式）
RUN cargo build --release --features onnx --package browerai-api-server

# ==================== Runtime Stage ====================
FROM debian:bookworm-slim

WORKDIR /app

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建非 root 用户
RUN useradd -m -u 1000 browerai

# 从 builder 阶段复制二进制
COPY --from=builder /app/target/release/browerai-api-server /app/browerai-api-server

# 复制模型文件
COPY --chown=browerai:browerai models /app/models
COPY --chown=browerai:browerai certs /app/certs

# 设置权限
RUN chown -R browerai:browerai /app

# 切换到非 root 用户
USER browerai

# 环境变量
ENV MODEL_DIR=/app/models/onnx_exports
ENV RUST_LOG=info
ENV LISTEN_ADDR=0.0.0.0:3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

# 暴露端口
EXPOSE 3000

# 启动应用
CMD ["/app/browerai-api-server"]
