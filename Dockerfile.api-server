# Docker化部署配置
FROM python:3.13-slim

LABEL maintainer="BrowerAI Team"
LABEL description="Framework Detection API Server"

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# 复制requirements
COPY requirements.txt .

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir flask gunicorn torch --index-url https://download.pytorch.org/whl/cpu

# 复制应用代码
COPY training/ /app/training/
COPY models/ /app/models/

# 暴露端口
EXPOSE 5000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import requests; requests.get('http://localhost:5000/health')" || exit 1

# 启动服务
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "--timeout", "120", "training.api_server:app"]
