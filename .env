# BrowerAI runtime configuration
# JS orchestration policy: one of performance | secure | balanced
# Default is balanced when unset
BROWERAI_JS_POLICY=

# Database configuration for integration tests and benchmarks
# Update DATABASE_URL to point to your PostgreSQL instance
DATABASE_URL=postgres://postgres:postgres@localhost:5432/browerai
# Optional: tune pool size for tests/benchmarks
DB_MAX_CONNECTIONS=10
